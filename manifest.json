{
  "manifest_version": 3,
  "name": "Tabnote — Smart Tab Organizer",
  "version": "0.14.2",
  "description": "Group tabs by website or task, share tab sets, and reset Tabnote groups in one click.",
  "minimum_chrome_version": "102",
  "permissions": ["tabs", "tabGroups", "storage"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tabnote",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
